{
  "name": "oneframe-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local playground for making 3D content from a single photo, from plug-and-play model nodes.",
  "type": "module",
  "main": "app/main/main.js",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "npm run page:build && electron .",
    "page:build": "node scripts/page-build.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.page.json && tsc -p tsconfig.preload.json",
    "test": "node --test \"tests/app/**/*.test.js\"",
    "e2e": "npm run page:build && playwright test",
    "check": "npm run lint && npm run protocol:types && npm run typecheck && npm test && npm run docs:check",
    "engine:sync": "uv sync --project engine --frozen",
    "engine:check": "uv run --project engine --frozen ruff check && uv run --project engine --frozen ruff format --check && uv run --project engine --frozen pyright && npm run runtime:check && uv run --project engine --frozen pytest engine",
    "runtime:check": "node scripts/tool.js oneframe.runtime_check",
    "bench:runtime": "node scripts/tool.js oneframe.bench_runtime",
    "bench:fit": "node scripts/tool.js oneframe.bench_fit",
    "bench:fit-check": "node scripts/tool.js engine/tests/fit_check.py",
    "diagnose": "node scripts/tool.js oneframe.diagnose",
    "models:download": "node scripts/tool.js oneframe.models.tools download",
    "models:pin": "node scripts/tool.js oneframe.models.tools pin",
    "versions": "node scripts/check-versions.js",
    "docs:check": "node scripts/check-docs.js",
    "protocol:types": "node scripts/protocol-types.js",
    "test:guard": "node scripts/test-guard.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "three": "0.187.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": false
  }
}
